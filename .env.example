# Copy to .env.local (git-ignored) to turn analytics on for a build.
# Without both of these the extension collects nothing at all, which is what keeps a fork or a
# source-zip build silent by default.

# GA4 data stream -> Measurement ID
VITE_GOOGLE_ANALYTICS_MEASUREMENT_ID=G-XXXXXXXXXX
# GA4 Admin -> Data Streams -> the stream -> Measurement Protocol API secrets
VITE_GOOGLE_ANALYTICS_MEASUREMENT_API_SECRET=your-ga4-api-secret

# Only a PRODUCTION build reports. `pnpm dev` and any --mode development build stay silent no
# matter what is set here, so a session spent toggling settings never reaches a report.

# Only for `pnpm ga:dimensions`, and only when the property cannot be found from the measurement
# ID above (access granted on the property rather than the account).
# GA_PROPERTY_ID=000000000
# Service account whose token the script should mint the analytics.edit scope with.
# GA_ADMIN_ACCOUNT=someone@project.iam.gserviceaccount.com
